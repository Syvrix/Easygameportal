# LinuxGSM Web GUI – Backend Environment Variables
# Copy this file to .env and fill in your values

# Port the backend listens on
PORT=3001

# Frontend origin for CORS (set to your frontend URL in production)
# FRONTEND_ORIGIN=http://localhost:5173

# Root directory where game servers are installed
SERVERS_ROOT=/home/gameservers

# Path to the JSON database file (relative to project root)
DB_PATH=./data/servers.json

# Log level: error | warn | info | debug
LOG_LEVEL=info

# Secret key (used for future auth/JWT features)
APP_SECRET=change-me-in-production
